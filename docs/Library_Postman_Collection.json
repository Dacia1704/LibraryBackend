        {
          "name": "Create User",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"password123\",\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"identityNumber\": \"123456789012\",\n  \"avatar\": \"\",\n  \"roleId\": 1,\n  \"isActive\": true\n}" }, "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] } }
        },
        {
          "name": "Update User",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"password123\",\n  \"fullName\": \"John Doe Updated\",\n  \"email\": \"john@example.com\",\n  \"identityNumber\": \"123456789012\",\n  \"avatar\": \"\",\n  \"roleId\": 1,\n  \"isActive\": true\n}" }, "url": { "raw": "{{baseUrl}}/api/users/1", "host": ["{{baseUrl}}"], "path": ["api", "users", "1"] } }
        },
        {
          "name": "Delete User",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/users/1", "host": ["{{baseUrl}}"], "path": ["api", "users", "1"] } }
        },
        {
          "name": "Get User By ID",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/users/1", "host": ["{{baseUrl}}"], "path": ["api", "users", "1"] } }
        },
        {
          "name": "Get Users (Pagination)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/users?page=0&size=10&keyword=&email=&roleId=&isMember=&phone=", "host": ["{{baseUrl}}"], "path": ["api", "users"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }, { "key": "keyword", "value": "" }, { "key": "email", "value": "" }, { "key": "roleId", "value": "", "disabled": true }, { "key": "isMember", "value": "", "disabled": true }, { "key": "phone", "value": "", "disabled": true }] } }
        },
        {
          "name": "Get Deleted User",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/users/deleted/1", "host": ["{{baseUrl}}"], "path": ["api", "users", "deleted", "1"] } }
        }
      ]
    },
